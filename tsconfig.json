{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "lib": [
      "ESNext"
    ],
    "module": "preserve",
    "target": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "./dist",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "rootDir": "./src/",
    "strict": false,
    "sourceMap": true,
    "declaration": true,
    "types": [
      "bun"
    ],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "isolatedModules": true
  },
  "exclude": [
    "node_modules",
    "dist/**/*"
  ],
  "include": [
    "src/App/**/*",
    "src/AppContainer/**/*",
    "src/Authentication/**/*",
    "src/Authorization/**/*",
    "src/Cache/**/*",
    "src/Cli/**/*",
    "src/Common/**/*",
    "src/Contracts/**/*",
    "src/Cookies/**/*",
    "src/Crypt/**/*",
    "src/Database/**/*",
    "src/Events/**/*",
    "src/OAuthProvider/**/*",
    "src/Packages/**/*",
    "src/Routing/**/*",
    "src/Redis/**/*",
    "src/Queue/**/*",
    "src/Security/**/*",
    "src/Server/**/*",
    "src/WebSockets/**/*",
    "src/Session/**/*",
    "src/Storage/**/*.ts",
    "src/Queue/**/*.ts",
    "src/Model/**/*.ts",
    "src/Authenticatable.ts",
    "src/Envuso.ts",
    "src/tests/**/*.ts",
    "src/run-dev.ts",
    "src/index.ts"
  ]
}
