PORT=3000
NODE_ENV=development

# Required: long random secret (e.g. `openssl rand -hex 32`). Used for JWTs, cookie & session encryption.
APP_KEY=
APP_URL=http://127.0.0.1:3000
SERVER_ADDRESS=127.0.0.1

DB_URL=mongodb://127.0.0.1:27017
DB_NAME=envuso

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# S3-compatible storage (DigitalOcean Spaces / AWS / MinIO) — only needed for the s3 disk
SPACES_KEY=
SPACES_SECRET=
SPACES_ENDPOINT=
SPACES_URL=
SPACES_BUCKET=
SPACES_REGION=us-east-1
# true for MinIO / most self-hosted S3-compatible servers
SPACES_FORCE_PATH_STYLE=false
