{
  "version": "3.0.0-next.0",
  "name": "@envuso/core",
  "author": "Sam Parton @iDevelopThings",
  "description": "Envuso is a backend framework focusing building apis using Fastify and MongoDB support.",
  "license": "MIT",
  "scripts": {
    "front:build": "npx mix",
    "front:watch": "npx mix watch",
    "build": "tsc -p tsconfig-dist.json",
    "commit-files-for-publish": "cp package.json dist && cp readme.md dist && git add . && git commit -m \":package: Build and Increased version\"",
    "dev": "bun --watch src/run-dev.ts",
    "devo": "bun src/run-dev.ts",
    "test": "bun test --timeout 30000",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pack": "bun scripts/pack.ts",
    "release": "bun scripts/release.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1175.0",
    "@aws-sdk/s3-request-presigner": "^3.1175.0",
    "@envuso/date-time-helper": "^0.1.2-1",
    "@fastify/cors": "^11.4.3",
    "@fastify/formbody": "^9.0.2",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.9",
    "@zishone/dotnotate": "^0.1.3",
    "chalk": "^6.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "edge.js": "^5.3.1",
    "fastify": "^5.12.8",
    "fastify-raw-body": "^6.0.3",
    "file-type": "^22.3.0",
    "fs-extra": "^11.4.1",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.18.1",
    "mongodb": "^7.9.1",
    "pluralize": "^8.0.0",
    "reflect-metadata": "^0.2.2",
    "tslog": "^5.5.0",
    "tsyringe": "^4.10.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@inertiajs/inertia": "^0.10.1",
    "@inertiajs/inertia-vue3": "^0.5.2",
    "@testcontainers/mongodb": "^12.2.2",
    "@testcontainers/redis": "^12.2.2",
    "@types/bun": "^1.4.5",
    "@types/fs-extra": "^11.0.4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.17.27",
    "@types/pluralize": "^0.0.33",
    "@vue/compiler-sfc": "^3.2.9",
    "form-data": "^4.0.6",
    "laravel-mix": "^6.0.29",
    "testcontainers": "^12.2.2",
    "typescript": "7",
    "vue": "^3.2.9",
    "vue-loader": "^16.2.0"
  },
  "types": "./"
}
